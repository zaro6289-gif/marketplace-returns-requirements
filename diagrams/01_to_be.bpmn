<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="returns_defs" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="returns_collab"><bpmn:participant id="returns_part" name="Маркетплейс" processRef="returns"/></bpmn:collaboration>
<bpmn:process id="returns" isExecutable="false">
<bpmn:laneSet id="returns_ls"><bpmn:lane id="returns_lane0" name="Покупатель"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>apply</bpmn:flowNodeRef><bpmn:flowNodeRef>rej1</bpmn:flowNodeRef><bpmn:flowNodeRef>bring</bpmn:flowNodeRef><bpmn:flowNodeRef>rejend</bpmn:flowNodeRef><bpmn:flowNodeRef>money</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="returns_lane1" name="Система маркетплейса"><bpmn:flowNodeRef>check</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>qr</bpmn:flowNodeRef><bpmn:flowNodeRef>rej2</bpmn:flowNodeRef><bpmn:flowNodeRef>refund</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="returns_lane2" name="Сотрудник ПВЗ"><bpmn:flowNodeRef>scan</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>accept</bpmn:flowNodeRef><bpmn:flowNodeRef>par</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="returns_lane3" name="Склад возвратов"><bpmn:flowNodeRef>wh</bpmn:flowNodeRef><bpmn:flowNodeRef>resell</bpmn:flowNodeRef><bpmn:flowNodeRef>whend</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="s" name="Решил вернуть товар"><bpmn:outgoing>f_s_apply</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="apply" name="Оформить заявку: причина, фото"><bpmn:incoming>f_s_apply</bpmn:incoming><bpmn:outgoing>f_apply_check</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="check" name="Проверить срок и категорию товара"><bpmn:incoming>f_apply_check</bpmn:incoming><bpmn:outgoing>f_check_g1</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g1" name="Возврат возможен?"><bpmn:incoming>f_check_g1</bpmn:incoming><bpmn:outgoing>f_g1_rej1</bpmn:outgoing><bpmn:outgoing>f_g1_qr</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="rej1" name="Отказ с пояснением"><bpmn:incoming>f_g1_rej1</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="qr" name="Сформировать QR-код возврата"><bpmn:incoming>f_g1_qr</bpmn:incoming><bpmn:outgoing>f_qr_bring</bpmn:outgoing></bpmn:serviceTask>
<bpmn:manualTask id="bring" name="Принести товар в ПВЗ"><bpmn:incoming>f_qr_bring</bpmn:incoming><bpmn:outgoing>f_bring_scan</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="scan" name="Сканировать QR, осмотреть товар"><bpmn:incoming>f_bring_scan</bpmn:incoming><bpmn:outgoing>f_scan_g2</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="g2" name="Товар соответствует?"><bpmn:incoming>f_scan_g2</bpmn:incoming><bpmn:outgoing>f_g2_rej2</bpmn:outgoing><bpmn:outgoing>f_g2_accept</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="rej2" name="Зафиксировать отказ, уведомить"><bpmn:incoming>f_g2_rej2</bpmn:incoming><bpmn:outgoing>f_rej2_rejend</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="rejend" name="Возврат отклонён"><bpmn:incoming>f_rej2_rejend</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="accept" name="Принять товар, выдать квитанцию"><bpmn:incoming>f_g2_accept</bpmn:incoming><bpmn:outgoing>f_accept_par</bpmn:outgoing></bpmn:userTask>
<bpmn:parallelGateway id="par" name=""><bpmn:incoming>f_accept_par</bpmn:incoming><bpmn:outgoing>f_par_refund</bpmn:outgoing><bpmn:outgoing>f_par_wh</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:serviceTask id="refund" name="Вернуть деньги на карту"><bpmn:incoming>f_par_refund</bpmn:incoming><bpmn:outgoing>f_refund_money</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="money" name="Деньги возвращены"><bpmn:incoming>f_refund_money</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="wh" name="Проверить товар"><bpmn:incoming>f_par_wh</bpmn:incoming><bpmn:outgoing>f_wh_resell</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="resell" name="Вернуть в продажу или продавцу"><bpmn:incoming>f_wh_resell</bpmn:incoming><bpmn:outgoing>f_resell_whend</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="whend" name="Товар обработан"><bpmn:incoming>f_resell_whend</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f_s_apply" sourceRef="s" targetRef="apply"/>
<bpmn:sequenceFlow id="f_apply_check" sourceRef="apply" targetRef="check"/>
<bpmn:sequenceFlow id="f_check_g1" sourceRef="check" targetRef="g1"/>
<bpmn:sequenceFlow id="f_g1_rej1" name="нет" sourceRef="g1" targetRef="rej1"/>
<bpmn:sequenceFlow id="f_g1_qr" name="да" sourceRef="g1" targetRef="qr"/>
<bpmn:sequenceFlow id="f_qr_bring" sourceRef="qr" targetRef="bring"/>
<bpmn:sequenceFlow id="f_bring_scan" sourceRef="bring" targetRef="scan"/>
<bpmn:sequenceFlow id="f_scan_g2" sourceRef="scan" targetRef="g2"/>
<bpmn:sequenceFlow id="f_g2_rej2" name="нет" sourceRef="g2" targetRef="rej2"/>
<bpmn:sequenceFlow id="f_rej2_rejend" sourceRef="rej2" targetRef="rejend"/>
<bpmn:sequenceFlow id="f_g2_accept" name="да" sourceRef="g2" targetRef="accept"/>
<bpmn:sequenceFlow id="f_accept_par" sourceRef="accept" targetRef="par"/>
<bpmn:sequenceFlow id="f_par_refund" sourceRef="par" targetRef="refund"/>
<bpmn:sequenceFlow id="f_refund_money" sourceRef="refund" targetRef="money"/>
<bpmn:sequenceFlow id="f_par_wh" sourceRef="par" targetRef="wh"/>
<bpmn:sequenceFlow id="f_wh_resell" sourceRef="wh" targetRef="resell"/>
<bpmn:sequenceFlow id="f_resell_whend" sourceRef="resell" targetRef="whend"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="returns_diagram"><bpmndi:BPMNPlane id="returns_plane" bpmnElement="returns_collab">
<bpmndi:BPMNShape id="returns_part_di" bpmnElement="returns_part" isHorizontal="true"><dc:Bounds x="0" y="0" width="2030" height="560"/></bpmndi:BPMNShape>
